# OurDAO backend configuration
# Copy to .env and fill in.

# --- HTTP API ---
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed CORS origins (the frontend URL). "*" allows all.
CORS_ORIGIN=http://localhost:3000
# Pino log level for the Fastify server (fatal, error, warn, info, debug, trace, silent).
# 'info' logs a line per request. 'silent' suppresses all request logging.
LOG_LEVEL=info
# Maximum time (ms) the /ready database probe may take before returning 503.
READY_CHECK_TIMEOUT_MS=3000

# --- Postgres ---
# Either a single connection string...
DATABASE_URL=postgres://ourdao:ourdao@localhost:5432/ourdao
# ...or leave DATABASE_URL empty and set these individually:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=ourdao
# PGPASSWORD=ourdao
# PGDATABASE=ourdao
# Nonce store backend: "postgres" (production, multi-instance) or "memory" (dev/testing).
# Postgres keeps nonces across API instances and survives restarts; memory is ephemeral.
# Defaults to "postgres" (issue #66).
NONCE_STORE=postgres
# Nonce TTL (5 minutes), in-memory capacity (10,000 entries), and cleanup
# cadences (memory: 1 minute; Postgres: 10 minutes) are fixed in src/auth.ts.
# They are intentionally not configurable; change and review the code to alter them.
# Maximum request-pool connections per process. The stream uses one additional
# dedicated LISTEN connection per API process, outside this pool.
DB_POOL_MAX=10
# Maximum time (ms) to wait for a pool connection.
DB_CONNECTION_TIMEOUT_MS=5000
# Postgres statement timeout (ms) applied to request-pool connections.
DB_STATEMENT_TIMEOUT_MS=10000

# --- Stellar / Soroban ---
# Deployed OurDAO contract id (starts with C). REQUIRED for the indexer to run.
CONTRACT_ID=
# Soroban RPC endpoint (public testnet default).
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Network passphrase. Mainnet: "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Nominal ledger close time used to estimate readiness lag; this is not an SLA.
STELLAR_LEDGER_CLOSE_TIME_SECONDS=5

# --- Indexer ---
# Ledger to begin indexing from. 0 = start from (latest - START_LOOKBACK_LEDGERS).
# Note: public Soroban RPC only retains ~24h of events, so a very old start
# ledger will be clamped to the oldest ledger the RPC still serves.
START_LEDGER=0
START_LOOKBACK_LEDGERS=17280
# How often to poll getEvents, in milliseconds.
POLL_INTERVAL_MS=5000
# Max events fetched per getEvents page.
EVENTS_PAGE_LIMIT=100
# Cap (ms) for the exponential backoff applied after consecutive poll failures.
POLL_MAX_BACKOFF_MS=60000
# Max pages to drain per poll iteration when behind (issue #3).
DRAIN_MAX_PAGES=20
# Max wall-clock ms for a single drain cycle (issue #3).
DRAIN_MAX_MS=30000
# How long (ms) the indexer cursor can be idle before /ready reports stale.
INDEXER_STALE_AFTER_MS=120000
# After this many consecutive whole-page failures with the same error on the
# same page, the poller stops treating it as transient and quarantines the
# offending event(s) one-per-transaction instead of retrying forever (issue #43).
INDEXER_QUARANTINE_AFTER_FAILURES=3
# The contract has no upgrade path, so a fix means a new CONTRACT_ID. If the
# saved cursor belongs to a different contract, the indexer refuses to start
# rather than merge two deployments' state. Set this to "true" for one boot
# to wipe the cursor + derived tables and re-index the new contract from
# scratch (the raw events log is kept). See README "Redeploying the contract".
INDEXER_RESET_ON_CONTRACT_CHANGE=false
# Note: The indexer (worker process) uses console.log/console.error directly and
# does not respect LOG_LEVEL. Its output is always shown regardless of this setting.

# --- Rate limiting ---
# Global rate limit: max requests per window per IP.
RATE_LIMIT_MAX=100
# Rate limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000
# Stricter limit for the heavy GET /api/events endpoint.
RATE_LIMIT_EVENTS_MAX=30
# How long (ms) an /api/stats result is cached in-process before recompute
# (issue #18). Reported figures are at most this stale. 0 disables the cache.
STATS_CACHE_MS=5000
# --- Event stream ---
# Every API process uses one shared Postgres LISTEN connection and fans events
# out to its local SSE clients. These caps therefore bound sockets and memory,
# not database connections.
STREAM_MAX_CONNECTIONS=100
STREAM_MAX_CONNECTIONS_PER_IP=10
# Idle timeout (ms) for an SSE socket with no reads/writes. Heartbeats every
# 30s keep healthy clients alive; dead sockets are closed (issue #156).
STREAM_IDLE_TIMEOUT_MS=60000
# Retry-After (seconds) returned with 503 when a stream cap is hit.
STREAM_RETRY_AFTER_SECONDS=30
# The 30-second heartbeat interval and the channel set are fixed in
# src/api/stream.ts. LISTEN/NOTIFY requires a direct or session-pooled Postgres
# connection; transaction pooling cannot preserve the listener session.
# Set to "true" behind a reverse proxy so rate limits apply per client IP.
TRUST_PROXY=false

# --- Tests ---
# Separate database `npm test` runs against (never the dev DB above). Create
# it once with: docker exec <db-container> psql -U ourdao -d postgres -c
# "CREATE DATABASE ourdao_test;"
TEST_DATABASE_URL=postgres://ourdao:ourdao@localhost:5432/ourdao_test

# --- Build and test tooling (normally set by Docker/CI, not operators) ---
# NODE_ENV=production
# SOURCE_COMMIT=git-sha
# BUILD_DATE=2026-01-01T00:00:00Z
# VITEST=true
# RUN_RPC_SMOKE=false
